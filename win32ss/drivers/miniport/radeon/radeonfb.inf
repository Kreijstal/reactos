; AMD Radeon ATOM-BIOS Framebuffer Miniport
;
; Binds the radeonfb videoport miniport (AtomBIOS modesetting, generic
; framebuf.dll display driver) to DCE6-class Radeons: Trinity/Richland
; APUs (Aruba, DCE 6.1) and Oland discrete cards (DCE 6.4), plus the
; display-less Hainan render companions found next to them in PowerXpress
; laptops (ASUS X550DP: 1002:990D + 1002:6660).

[Version]
Signature="$Windows NT$"
LayoutFile=layout.inf
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%ReactOS%
DriverVer=07/08/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12
RadeonFb.Miniport_CopyFiles=12
RadeonFb.Display_CopyFiles=11

[Manufacturer]
%AMD%=AMD,NTx86,NTamd64

