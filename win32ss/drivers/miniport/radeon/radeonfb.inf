[RadeonFb_Install]
CopyFiles=RadeonFb.Miniport_CopyFiles,RadeonFb.Display_CopyFiles
AddReg=RadeonFb_SoftwareSettings

[RadeonFb.Miniport_CopyFiles]
radeonfb.sys

[RadeonFb.Display_CopyFiles]
framebuf.dll

[RadeonFb_SoftwareSettings]
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,framebuf
HKR,,VgaCompatible,%REG_DWORD%,0
HKR,,DefaultSettings.VRefresh,%REG_DWORD%,1
HKR,,DefaultSettings.BitsPerPel,%REG_DWORD%,32
HKR,,DefaultSettings.XResolution,%REG_DWORD%,1024
HKR,,DefaultSettings.YResolution,%REG_DWORD%,768

[RadeonFb_Install.Services]
AddService=radeonfb,0x00000002,RadeonFb_Service

[RadeonFb_Service]
DisplayName=%RadeonFb.ServiceDesc%
ServiceType=1
StartType=1
ErrorControl=0
ServiceBinary=%12%\radeonfb.sys
LoadOrderGroup=Video

[Strings]
ReactOS="ReactOS"
AMD="Advanced Micro Devices"
RadeonFb.TrinityDesc="AMD Radeon HD 7000/8000 Series (Trinity/Richland APU)"
RadeonFb.OlandDesc="AMD Radeon HD 8500/8600/R7 240/250 Series (Oland)"
RadeonFb.HainanDesc="AMD Radeon HD 8500M/8600M Series (Hainan, render-only)"
RadeonFb.ServiceDesc="ReactOS AMD Radeon ATOM-BIOS Framebuffer Miniport"
REG_MULTI_SZ=0x00010000
REG_DWORD=0x00010001
REG_SZ=0x00000000
