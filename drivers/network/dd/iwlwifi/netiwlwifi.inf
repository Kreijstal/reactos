%IWL_06F0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_06F0
%IWL_34F0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_34F0
%IWL_3DF0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_3DF0
%IWL_43F0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_43F0
%IWL_4DF0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_4DF0
