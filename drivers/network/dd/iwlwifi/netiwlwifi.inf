%IWL_7AF0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_7AF0
%IWL_7E40.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_7E40
%IWL_54F0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_54F0
%IWL_51F0.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_51F0
%IWL_51F1.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_51F1
%IWL_272B.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_272B
%IWL_A840.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_A840
%IWL_7740.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_7740
%IWL_4D40.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_4D40
[IWL_Inst.ndi.NT]
Characteristics = 0x84 ; NCF_PHYSICAL | NCF_HAS_UI
BusType         = 5    ; PCIBus
AddReg          = IWL_AddReg.NT
CopyFiles       = IWL_CopyFiles.NT

[IWL_Inst.ndi.NT.HW]
AddReg = IWL_HwAddReg.NT

[IWL_CopyFiles.NT]
iwlwifi.sys

[IWL_AddReg.NT]
HKR, Ndi,            Service,    0, "iwlwifi"
; Expose a Native Wi-Fi lower adapter to nwifi.  Advertising ndis5 here
; would make the device look like an Ethernet miniport and stop the nwifi
; intermediate driver from binding to it.
HKR, Ndi\Interfaces, UpperRange, 0, "nativewifi"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan"

[IWL_HwAddReg.NT]
HKR, Interrupt Management,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,MSISupported,0x00010001,1

[IWL_Inst.ndi.NT.Services]
AddService = iwlwifi, 0x00000002, IWL_Service_Inst

[IWL_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 0
ServiceBinary  = %12%\iwlwifi.sys
LoadOrderGroup = NDIS

