; NETIWLWIFI.INF
;
; Installation file for Intel Wireless PCIe NICs (NDIS 6.20).
;
; The hardware-ID list below is generated from IwlDeviceTable in
; hw/devices.c and MUST stay in step with it: an ID here that the table
; does not know makes the driver bind and then refuse the device, and an ID
; in the table that is missing here is simply never reached.
;
; Only 8086:51F1 has been exercised against real silicon.  Every other ID
; is transcribed from the upstream iwlwifi PCI table - see the verification
; note at the top of hw/devices.c.

[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 08/25/2026,0.01

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%IntelMfg% = IntelMfg

[IntelMfg]
%IWL_4232.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_4232
%IWL_4235.DeviceDesc% = IWL_Inst.ndi,PCI\VEN_8086&DEV_4235
