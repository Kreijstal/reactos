; NETVWIFI.INF
;
; Installation file for the Virtual Wi-Fi NDIS 6.20 native-802.11 miniport.
; Software-only: enumerated under Root\\vwifi so it loads without any PCI
; hardware. Intended for upper-stack development (wlansvc / wlanapi /
; OID_DOT11_* / WPA2-PSK testing).

[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 05/21/2026,0.01

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ReactOSMfg% = ReactOSMfg

[ReactOSMfg]
%VWIFI.DeviceDesc% = VWIFI_Inst.ndi,Root\\vwifi

[VWIFI_Inst.ndi.NT]
Characteristics = 0x80   ; NCF_HAS_UI
BusType         = 15     ; INTERNAL_BUS
AddReg          = VWIFI_AddReg.NT
CopyFiles       = VWIFI_CopyFiles.NT

[VWIFI_CopyFiles.NT]
vwifi.sys

[VWIFI_AddReg.NT]
HKR, Ndi,            Service,    0, "vwifi"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan"

[VWIFI_Inst.ndi.NT.Services]
AddService = vwifi, 0x00000002, VWIFI_Service_Inst

[VWIFI_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 0
ServiceBinary  = %12%\\vwifi.sys
LoadOrderGroup = NDIS

;----------------------------------- STRINGS -----------------------------

[Strings]
ReactOS           = "ReactOS Project"
ReactOSMfg        = "ReactOS"
VWIFI.DeviceDesc  = "ReactOS Virtual Wi-Fi Adapter"
