; NETAR9485.INF
;
; Installation file for the Atheros AR9485 PCIe Wi-Fi NIC (NDIS 6.20).
; Bound only to PCI 168C:0032; broader ath9k chip coverage is deferred
; until the AR9485-specific port is stable.

[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 05/20/2026,0.01

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%AthMfg% = AthMfg

[AthMfg]
%AR9485.DeviceDesc% = AR9485_Inst.ndi,PCI\VEN_168C&DEV_0032

[AR9485_Inst.ndi.NT]
Characteristics = 0x84 ; NCF_PHYSICAL | NCF_HAS_UI
BusType         = 5    ; PCIBus
AddReg          = AR9485_AddReg.NT
CopyFiles       = AR9485_CopyFiles.NT

[AR9485_Inst.ndi.NT.HW]
AddReg = AR9485_HwAddReg.NT

[AR9485_CopyFiles.NT]
ar9485.sys

[AR9485_AddReg.NT]
HKR, Ndi,            Service,    0, "ar9485"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan"

[AR9485_HwAddReg.NT]
HKR, Interrupt Management,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,,0x00000010
HKR, Interrupt Management\MessageSignaledInterruptProperties,MSISupported,0x00010001,1

[AR9485_Inst.ndi.NT.Services]
AddService = ar9485, 0x00000002, AR9485_Service_Inst

[AR9485_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 0
ServiceBinary  = %12%\ar9485.sys
LoadOrderGroup = NDIS

;----------------------------------- STRINGS -----------------------------

[Strings]
ReactOS              = "ReactOS Project"
AthMfg               = "Atheros / Qualcomm"
AR9485.DeviceDesc    = "Atheros AR9485 Wireless Network Adapter"
