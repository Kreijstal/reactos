; WDDM kernel display stack service registration (livecd preinstall)
;
; dxgkrnl is the WDDM display port driver. It is loaded at boot, like on
; Windows, and is also pulled in as an import by every WDDM miniport
; (e.g. viogpudo.sys). For each started WDDM adapter it creates
; \Device\VideoN, writes the HARDWARE\DEVICEMAP\VIDEO entry and sets
; InstalledDisplayDrivers=cdd, so win32k drives the adapter through cdd.dll.
;
; Machines without a WDDM adapter keep the legacy XPDM path (videoprt +
; vga/vbe/uefifb miniports); dxgkrnl stays idle there.
;
; dxgmms1 and the softgpu Basic-Display fallback are built but not registered:
; dxgkrnl does not use dxgmms1 yet, and softgpu would take the firmware
; framebuffer away from uefifb. See softgpu/softgpu_reg.inf.

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ImagePath",0x00020000,"system32\drivers\dxgkrnl.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Tag",0x00010001,0x00000002
