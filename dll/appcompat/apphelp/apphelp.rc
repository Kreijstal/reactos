#include <windef.h>

/* apphelp behaves like the Windows version it is built for */
#if (_WIN32_WINNT >= 0x0A00)
#define APPHELP_VERSION 10,0,10240,0
#define APPHELP_STR_VERSION "10.0.10240.0"
#define APPHELP_STR_PRODUCT_VERSION "10.0"
#elif (_WIN32_WINNT >= 0x0603)
#define APPHELP_VERSION 6,3,9600,0
#define APPHELP_STR_VERSION "6.3.9600.0"
#define APPHELP_STR_PRODUCT_VERSION "6.3"
#elif (_WIN32_WINNT >= 0x0602)
#define APPHELP_VERSION 6,2,9200,0
#define APPHELP_STR_VERSION "6.2.9200.0"
#define APPHELP_STR_PRODUCT_VERSION "6.2"
#elif (_WIN32_WINNT >= 0x0601)
#define APPHELP_VERSION 6,1,7600,0
#define APPHELP_STR_VERSION "6.1.7600.0"
#define APPHELP_STR_PRODUCT_VERSION "6.1"
#elif (_WIN32_WINNT >= 0x0600)
#define APPHELP_VERSION 6,0,6000,0
#define APPHELP_STR_VERSION "6.0.6000.0"
#define APPHELP_STR_PRODUCT_VERSION "6.0"
#else
#define APPHELP_VERSION 5,2,3790,0
#define APPHELP_STR_VERSION "5.2.3790.0"
#define APPHELP_STR_PRODUCT_VERSION "5.2"
#endif

#define REACTOS_FILEVERSION APPHELP_VERSION
#define REACTOS_STR_FILE_VERSION APPHELP_STR_VERSION
#define REACTOS_PRODUCTVERSION APPHELP_VERSION
#define REACTOS_STR_PRODUCT_VERSION APPHELP_STR_PRODUCT_VERSION

#define REACTOS_STR_FILE_DESCRIPTION  "Application compatibility module"
#define REACTOS_STR_INTERNAL_NAME     "apphelp"
#define REACTOS_STR_ORIGINAL_FILENAME "apphelp.dll"
#include <reactos/version.rc>
